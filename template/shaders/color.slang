// 颜色。所有着色器都 #include 这个文件，走同一条颜色通路。
//
// ---------------------------------------------------------------------------
// 为什么颜色一律写成 OKLCH
// ---------------------------------------------------------------------------
// RGB 有两个麻烦。一是数值和眼睛看到的东西不成比例：`#808080` 数值上正好在黑白
// 中点，实际发出的光只有白色的 21.6%。二是数值离不开一套基色——同一组 RGB 在
// sRGB 和 Display P3 下是不同的颜色，所以「这个数是什么颜色」这个问题在 RGB 里
// 根本没有答案，得先问「相对哪个色域」。
//
// OKLCH 两个麻烦都没有。它是 Oklab 色彩空间的极坐标形式，建立在 CIE XYZ 上，
// 是绝对的：L=0.72, C=0.16, H=250° 就是一个确定的颜色，和输出到哪儿无关。而且它
// 是感知均匀的——数值上等距对应眼睛看到的等距。
//
//   L  亮度   0 到 1。L=0.5 就是你眼里的中等亮度，不是数值上的一半。
//   C  彩度   从 0 开始，0 是灰。sRGB 大约到 0.3 出头，Display P3 更宽一些。
//   H  色相   角度，0 到 360 度，转一圈是红橙黄绿青蓝紫再回到红。
//
// 三个量是解耦的：想让颜色变暗只动 L，色相和鲜艳度纹丝不动；想做一整套同色系的
// 深浅色阶，固定 H 和 C 把 L 排成一列就行。这两件事在 RGB 里都得靠调参数试。
//
// ---------------------------------------------------------------------------
// 输出色域在创建管线时就固化了
// ---------------------------------------------------------------------------
// 交换链会尽量输出到显示器支持的最宽色域（见 src/swapchain.cpp）。选中哪个之后
// 整个程序生命周期都不会变，所以用 specialization constant：创建管线时把这个值
// 填进去，驱动编译着色器时会把下面那些 if 直接折叠掉，运行期一条分支都不剩。
[[vk::constant_id(0)]] const uint kGamut = 0;   // 0 = sRGB, 1 = Display P3

// OKLCH -> Oklab。极坐标转直角坐标，就这两行。
float3 oklchToOklab(float3 oklch)
{
    float h = radians(oklch.z);   // 色相存的是度，三角函数要弧度
    return float3(oklch.x, oklch.y * cos(h), oklch.y * sin(h));
}

// Oklab -> 输出色域的 linear RGB。
//
// Oklab 内部是通过一个叫 LMS 的中间空间定义的（LMS 对应人眼三种视锥细胞的响应），
// 所以要先从 Lab 转到 LMS 的立方根空间，立方还原，再乘一个矩阵变成 RGB。
//
// 第一组系数出自 Björn Ottosson 的 Oklab 原始实现。两组矩阵都可以自己推：把对应
// 色域的基色坐标和 D65 白点算出 RGB->XYZ，取逆，再接上 XYZ->LMS 的逆。
float3 oklabToLinearRgb(float3 lab)
{
    float l_ = lab.x + 0.3963377774 * lab.y + 0.2158037573 * lab.z;
    float m_ = lab.x - 0.1055613458 * lab.y - 0.0638541728 * lab.z;
    float s_ = lab.x - 0.0894841775 * lab.y - 1.2914855480 * lab.z;

    float l = l_ * l_ * l_;
    float m = m_ * m_ * m_;
    float s = s_ * s_ * s_;

    if (kGamut == 1) {
        // LMS -> linear Display P3
        return float3(
            +3.1281105290 * l - 2.2570750184 * m + 0.1293047884 * s,
            -1.0911281609 * l + 2.4132667618 * m - 0.3221681709 * s,
            -0.0260136497 * l - 0.5080276490 * m + 1.5333166822 * s);
    }
    // LMS -> linear sRGB
    return float3(
        +4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
        -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
        -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s);
}

// 这个 RGB 是不是落在色域里（三个通道都在 0 到 1 之间）。
bool inGamut(float3 rgb)
{
    return all(rgb >= -1e-4) && all(rgb <= 1.0 + 1e-4);
}

// OKLCH -> 输出色域的 linear RGB，超出色域的颜色自动映射回来。
//
// OKLCH 能表达的颜色比任何屏幕都多，所以一定会有画不出来的颜色，问题是怎么处理。
//
// 最省事的做法是把 RGB 三个通道各自截断到 [0,1]。但那样会同时改掉亮度和色相：
// 实测下来亮度能偏 0.09，色相能偏 8 度以上（青色一带最严重）。也就是说你要一个
// 很鲜的青，拿到的是一个偏蓝、还变亮了的青——两个本该解耦的量被连带改掉了，
// 正好把选 OKLCH 的意义抹掉。
//
// 这里的做法是保持 L 和 H 不动，只把 C 降到刚好落进色域为止。视觉上就是「这个
// 颜色鲜不到那个程度，那就给你最鲜的那个」，亮度和色相分毫不差。
//
// 找那个临界 C 用二分：色域是凸的，「在不在色域内」关于 C 单调，所以二分必然收敛。
// 每次迭代就是一次矩阵乘，而这个函数在顶点着色器里每个图形只跑几次，代价可以忽略。
float3 oklchToLinearRgb(float3 oklch)
{
    float3 rgb = oklabToLinearRgb(oklchToOklab(oklch));
    if (inGamut(rgb)) {
        return rgb;
    }

    // lo 一侧始终在色域内（C=0 是灰色，任何色域都包含），hi 一侧始终在外面。
    float lo = 0.0;
    float hi = oklch.y;
    for (int i = 0; i < 16; ++i) {
        float mid = 0.5 * (lo + hi);
        if (inGamut(oklabToLinearRgb(oklchToOklab(float3(oklch.x, mid, oklch.z))))) {
            lo = mid;
        } else {
            hi = mid;
        }
    }

    // 用 lo（确定在色域内的那一侧）。saturate 只是抹掉二分留下的浮点毛刺。
    return saturate(oklabToLinearRgb(oklchToOklab(float3(oklch.x, lo, oklch.z))));
}
