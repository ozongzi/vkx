# 签名密钥：由 vkx 生成，属于本机凭据，不要提交
android/keystore/
android/keystore.properties
.idea/

# iOS / Xcode
*.xcodeproj/xcuserdata/
DerivedData/

# vkx 生成，不进版本库
CMakePresets.json
